---
import '@fontsource/anton/400.css';
import '@fontsource/caveat-brush/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import '../styles/journey.css';
import '../styles/film.css';
import Lock from '../components/Lock.astro';
import Journey from '../components/Journey.astro';
---
<!doctype html>
<html lang="cs" class="locked">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d0b09" />
    <title>Mise Kolis</title>
    <meta name="description" content="Přihláška Jana Kolátora na pozici Mission Coordinator. Nejdřív ale musíš rozsvítit." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%230d0b09'/><circle cx='16' cy='16' r='7' fill='%23f4c15d'/></svg>" />
    <noscript><style>.lock { display: none !important; } html.locked { overflow: auto !important; }</style></noscript>
  </head>
  <body>
    <Lock />
    <Journey />
  </body>
</html>
