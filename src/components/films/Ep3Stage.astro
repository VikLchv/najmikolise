---
import Gap from '../Gap.astro';
import { films } from '../../data/mission';

const film = films.ep3;
const { nano, energy } = film;

// What the microscope sees: starch grains that turn into a web of fibres. Fixed numbers, so every run looks the same.
const fibers = Array.from({ length: 24 }, (_, i) => {
  const a = i * 2.4;
  const x1 = 100 + Math.cos(a) * 112;
  const y1 = 100 + Math.sin(a) * 112;
  const x2 = 100 - Math.cos(a + 0.6) * 112;
  const y2 = 100 - Math.sin(a + 0.6) * 112;
  const cx = 100 + Math.sin(i * 1.3) * 62;
  const cy = 100 + Math.cos(i * 1.9) * 62;
  return { i, d: `M${x1.toFixed(1)} ${y1.toFixed(1)}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}` };
});
const grains = Array.from({ length: 11 }, (_, i) => ({
  i,
  x: 100 + Math.cos(i * 2.1) * (22 + (i * 17) % 58),
  y: 100 + Math.sin(i * 2.1) * (22 + (i * 17) % 58),
  r: (i * 41) % 90,
}));
const heap = Array.from({ length: 70 }, (_, i) => i);
---
<div class="film-stage f3" data-film="ep3" hidden>
  <img class="film-portrait" src={film.portrait} alt="" />
  <div class="f3-open" aria-hidden="true">
    <p class="f3-rec"><i></i>{film.rec}</p>
    <p class="f3-title">{film.title}</p>
  </div>

  <div class="f3-gantt" aria-hidden="true">
    {film.rows.map((row, i) => (
      <div class={`f3-row f3-row-b${row.beat}`} style={`--i:${i}`}>
        <span class="f3-label">{row.label}</span>
        <span class="f3-track"><i style={`--from:${row.from};--to:${row.to}`}></i></span>
      </div>
    ))}
    <div class="f3-stamps">
      {film.stamps.map((s, i) => <span class="f3-stamp" style={`--i:${i}`}>{s}</span>)}
    </div>
  </div>

  <div class="f3-meters" aria-hidden="true">
    {film.meters.map((m) => (
      <div class="f3-meter">
        <span class="f3-meter-label">{m.label}</span>
        <svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M0 10h200" /></svg>
        <span class="f3-meter-value">{m.value}</span>
      </div>
    ))}
  </div>

  <div class="f3-nano" aria-hidden="true">
    <div class="f3-n f3-n6">
      <svg class="f3-scope" viewBox="0 0 200 200">
        <defs><clipPath id="f3Lens"><circle cx="100" cy="100" r="94" /></clipPath></defs>
        <circle class="f3-lens" cx="100" cy="100" r="94" />
        <g clip-path="url(#f3Lens)">
          {grains.map((g) => <ellipse class="f3-grain" cx={g.x} cy={g.y} rx="9" ry="6.5" transform={`rotate(${g.r} ${g.x} ${g.y})`} style={`--i:${g.i}`} />)}
          {fibers.map((f) => <path class="f3-fiber" d={f.d} pathLength="1" style={`--i:${f.i}`} />)}
        </g>
        <circle class="f3-rim" cx="100" cy="100" r="94" />
      </svg>
      <div class="f3-source">
        <p class="f3-source-title">{nano.source.title}</p>
        <p class="f3-source-note">{nano.source.note}</p>
        <ul class="f3-tags">{nano.source.tags.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
      </div>
    </div>

    <div class="f3-n f3-n7">
      {nano.products.map((p, i) => (
        <figure class={`f3-product f3-${p.kind}`} style={`--i:${i}`}>
          <svg viewBox="0 0 100 110">
            <path class="f3-face" d="M50 6C28 6 16 24 16 46c0 28 16 56 34 56s34-28 34-56C84 24 72 6 50 6z" />
            {p.kind === 'filter' ? (
              <>
                <path class="f3-strap" d="M17 50l20 12M83 50L63 62M22 72l15 2M78 72l-15 2" />
                <path class="f3-mask" d="M50 50c-10 0-20 6-24 18 2 16 12 28 24 28s22-12 24-28c-4-12-14-18-24-18z" />
                <path class="f3-weave" d="M34 66h32M31 74h38M34 82h32M41 90h18" />
              </>
            ) : (
              <>
                <path class="f3-mask" fill-rule="evenodd" d="M50 10C31 10 20 26 20 46c0 26 14 52 30 52s30-26 30-52C80 26 69 10 50 10zM30 40h14v8H30zM56 40h14v8H56zM40 72h20v6H40z" />
                {p.kind === 'cosmetic' ? (
                  <g class="f3-drops">
                    <path d="M26 16c-3 4-5 6-5 9a5 5 0 0 0 10 0c0-3-2-5-5-9z" />
                    <path d="M76 12c-3 4-5 6-5 9a5 5 0 0 0 10 0c0-3-2-5-5-9z" />
                    <path d="M86 66c-3 4-5 6-5 9a5 5 0 0 0 10 0c0-3-2-5-5-9z" />
                  </g>
                ) : (
                  <g class="f3-spots">
                    <circle cx="32" cy="58" r="3" /><circle cx="41" cy="62" r="2.2" /><circle cx="66" cy="60" r="3" /><circle cx="60" cy="30" r="2.4" /><circle cx="38" cy="28" r="2" /><circle cx="70" cy="52" r="2" />
                  </g>
                )}
              </>
            )}
          </svg>
          <figcaption><b>{p.name}</b><span>{p.note}</span></figcaption>
        </figure>
      ))}
    </div>

    <div class="f3-n f3-n8">
      <div class="f3-heap-box">
        <div class="f3-heap">{heap.map((i) => <i style={`--i:${i}`}></i>)}</div>
        <p class="f3-n8-label">{nano.heap}</p>
      </div>
      <div class="f3-ground-box">
        <svg class="f3-ground" viewBox="0 0 200 130">
          <rect class="f3-soil" x="0" y="82" width="200" height="48" />
          <path class="f3-sprout" pathLength="1" d="M100 100C100 80 98 60 100 34" />
          <path class="f3-leaf" d="M100 50c8-14 22-16 30-14-2 10-14 20-30 14z" />
          <path class="f3-leaf f3-leaf-2" d="M100 62c-8-12-20-14-28-12 2 10 12 18 28 12z" />
          <g class="f3-rotting">
            <rect x="74" y="88" width="16" height="9" rx="3" /><rect x="93" y="86" width="14" height="10" rx="3" /><rect x="110" y="88" width="16" height="9" rx="3" />
          </g>
        </svg>
        <p class="f3-n8-label">{nano.ground}</p>
      </div>
      <p class="f3-market">{nano.market}</p>
    </div>

    <div class="f3-n f3-n9">
      <svg class="f3-house" viewBox="0 0 260 150">
        <g class="f3-sun"><circle cx="30" cy="30" r="13" /><path d="M30 8v-6M30 58v-6M8 30H2M58 30h-6M14 14l-4-4M50 50l-4-4M14 46l-4 4M50 10l-4 4" /></g>
        <path class="f3-wall" d="M72 62h86v74H72z" />
        <path class="f3-roof" d="M62 62l53-34 53 34z" />
        <g class="f3-panels">
          <path d="M120 33l11 7-3 3-11-7zM134 42l11 7-3 3-11-7zM148 51l11 7-3 3-11-7z" />
        </g>
        <g class="f3-windows"><rect x="82" y="74" width="16" height="16" /><rect x="107" y="74" width="16" height="16" /><rect x="132" y="74" width="16" height="16" /><rect x="82" y="102" width="16" height="16" /><rect x="132" y="102" width="16" height="16" /></g>
        <path class="f3-door" d="M107 136v-30h16v30" />
        <path class="f3-ground-line" d="M0 136h260" />
        <path class="f3-flow" d="M160 62c10 8 22 18 22 40" />
        <g class="f3-battery"><rect class="f3-batt-shell" x="172" y="102" width="20" height="34" /><rect class="f3-batt-cap" x="178" y="98" width="8" height="4" /><rect class="f3-batt-fill" x="175" y="105" width="14" height="28" /></g>
        <path class="f3-flow f3-flow-2" d="M192 120h14" />
        <g class="f3-charger"><rect x="206" y="108" width="10" height="28" /><path d="M216 116c8 0 10 4 10 10" /></g>
        <path class="f3-car" d="M222 136v-8l6-8h18l8 8v8z" />
      </svg>
      <div class="f3-energy">
        <p class="f3-energy-title">{energy.title}</p>
        <ul class="f3-tags f3-parts">{energy.parts.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
        <p class="f3-trend f3-trend-down"><b>↓</b> {energy.down}</p>
        <p class="f3-trend f3-trend-up"><b>↑</b> {energy.up}</p>
      </div>
    </div>
  </div>

  <p class="f3-caption f3-caption-nano" aria-hidden="true">
    <b>{film.nanoCaption.species}</b>
    <span>{film.nanoCaption.habitat}</span>
  </p>

  <p class="f3-caption" aria-hidden="true">
    <b>{film.caption.species}</b>
    <span>{film.caption.habitat}</span>
  </p>

  <div class="film-end f3-end" hidden>
    <h3 class="film-end-title">{film.endTitle}</h3>
    <dl class="f3-credits">
      {film.endCredits.map((c) => (
        <div>
          <dt>{c.key}</dt>
          <dd>{c.value}</dd>
        </div>
      ))}
    </dl>
    <p class="f3-project">
      <strong>{film.projectLabel}:</strong>{' '}
      {film.project ?? <Gap label="projekt s číslem, bez jména firmy" />}
    </p>
  </div>
</div>
